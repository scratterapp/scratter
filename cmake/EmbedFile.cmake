# Turns a file into C++ source, so a program can carry it inside itself
# instead of looking for it on disk. am-ui uses it for its fonts.
#
#   am_embed_file(<target> <file> <function>)
#
# adds a generated .cpp to <target> that defines
#
#   std::span<const unsigned char> am::embedded::<function>();
#
# returning the file's bytes. Declare the function in a header to call it
# (src/client/fonts/embedded_fonts.hpp does). The .cpp is made again whenever
# the file changes.

function(am_embed_file target file function)
    set(output "${CMAKE_CURRENT_BINARY_DIR}/embedded/${function}.cpp")
    add_custom_command(
        OUTPUT "${output}"
        COMMAND "${CMAKE_COMMAND}" -DINPUT=${file} -DOUTPUT=${output} -DFUNCTION=${function}
                -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        DEPENDS "${file}" "${CMAKE_CURRENT_FUNCTION_LIST_FILE}"
        COMMENT "Embedding ${file}"
        VERBATIM
    )
    target_sources(${target} PRIVATE "${output}")
endfunction()

# Run as a script (cmake -P) by the command above: does the conversion.
if(CMAKE_SCRIPT_MODE_FILE)
    file(READ "${INPUT}" hex HEX)
    # "a1b2..." -> "0xa1,0xb2,...", then a line break every 16 bytes.
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){16})" "\\1\n" bytes "${bytes}")
    file(WRITE "${OUTPUT}"
        "// Generated by cmake/EmbedFile.cmake from ${INPUT}. Don't edit.\n"
        "#include <span>\n\n"
        "namespace am::embedded {\n\n"
        "std::span<const unsigned char> ${FUNCTION}();\n\n"
        "std::span<const unsigned char> ${FUNCTION}() {\n"
        "    static constexpr unsigned char kBytes[] = {\n${bytes}\n};\n"
        "    return kBytes;\n"
        "}\n\n"
        "} // namespace am::embedded\n")
endif()
