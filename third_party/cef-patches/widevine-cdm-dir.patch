 std::unique_ptr<content::CdmInfo> CreateWidevineCdmInfo(
@@ -83,7 +85,7 @@ std::unique_ptr<content::CdmInfo> CreateCdmInfoFromWidevineDirectory(
   // Library should be inside a platform specific directory.
