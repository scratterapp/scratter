   }
+#elif BUILDFLAG(IS_WIN) && BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)
+  // Without the switch, Component Update registers Widevine as usual.
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch(kWidevineCdmDirSwitch)) {
+    const base::FilePath dir =
+        command_line->GetSwitchValuePath(kWidevineCdmDirSwitch);
+    std::unique_ptr<content::CdmInfo> widevine =
+        CreateCdmInfoFromWidevineDirectory(dir);
+    if (widevine) {
+      VLOG(1) << "Registering Widevine " << widevine->capability->version
+              << " from " << dir;
+      cdms->push_back(*widevine);
+    } else {
+      LOG(WARNING) << "No usable Widevine CDM in " << dir;
