     return nullptr;
@@ -101,7 +103,15 @@ std::unique_ptr<content::CdmInfo> CreateCdmInfoFromWidevineDirectory(
 }
 #endif  // (BUILDFLAG(BUNDLE_WIDEVINE_CDM) ||
         // BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT)) && (BUILDFLAG(IS_LINUX) ||
