+        // BUILDFLAG(IS_CHROMEOS) || BUILDFLAG(IS_WIN))
+
+#if BUILDFLAG(ENABLE_WIDEVINE_CDM_COMPONENT) && BUILDFLAG(IS_WIN)
+// Scratter: an embedder that runs with --disable-component-update can name an
+// installed Widevine CDM folder (the one with manifest.json) with this switch,
+// and it is registered directly, the way Linux registers the hinted CDM.
+// Nothing is downloaded or copied.
+constexpr char kWidevineCdmDirSwitch[] = "widevine-cdm-dir";
+#endif
 
 #if BUILDFLAG(BUNDLE_WIDEVINE_CDM) && \
     (BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS))
@@ -245,6 +255,23 @@ void AddSoftwareSecureWidevine(std::vector<content::CdmInfo>* cdms) {
       cdms->push_back(*hinted_widevine);
